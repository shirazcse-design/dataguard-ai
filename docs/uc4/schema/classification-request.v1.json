{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_latency_ms": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Latency Ms"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "Caller": {
      "additionalProperties": false,
      "properties": {
        "caller_id": {
          "default": "local",
          "maxLength": 200,
          "minLength": 1,
          "title": "Caller Id",
          "type": "string"
        },
        "purpose": {
          "default": "classification",
          "maxLength": 200,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        }
      },
      "title": "Caller",
      "type": "object"
    },
    "Document": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "existing_labels": {
          "items": {
            "$ref": "#/$defs/ExistingLabel"
          },
          "maxItems": 50,
          "title": "Existing Labels",
          "type": "array"
        },
        "extension": {
          "maxLength": 32,
          "title": "Extension",
          "type": "string"
        },
        "filename": {
          "maxLength": 255,
          "title": "Filename",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 50,
          "title": "Metadata",
          "type": "object"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        }
      },
      "required": [
        "content",
        "filename",
        "extension"
      ],
      "title": "Document",
      "type": "object"
    },
    "ExistingLabel": {
      "additionalProperties": false,
      "properties": {
        "scheme": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Scheme",
          "type": "string"
        },
        "value": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "value"
      ],
      "title": "ExistingLabel",
      "type": "object"
    },
    "Options": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "include_evidence": {
          "default": true,
          "title": "Include Evidence",
          "type": "boolean"
        },
        "max_llm_tier": {
          "default": "large",
          "enum": [
            "none",
            "small",
            "mid",
            "large"
          ],
          "title": "Max Llm Tier",
          "type": "string"
        },
        "mode": {
          "default": "hybrid",
          "enum": [
            "hybrid",
            "rules",
            "ml",
            "llm"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "Options",
      "type": "object"
    }
  },
  "$id": "https://dataguard.example/uc4/schema/classification-request.v1.json",
  "additionalProperties": false,
  "properties": {
    "caller": {
      "$ref": "#/$defs/Caller"
    },
    "document": {
      "$ref": "#/$defs/Document"
    },
    "options": {
      "$ref": "#/$defs/Options"
    },
    "request_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "document"
  ],
  "title": "ClassificationRequest",
  "type": "object",
  "x-schema-version": "1.0"
}
